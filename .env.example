# Copy to .env or use bun scripts/setup.ts. Never commit real credentials.
OWNER_EMAIL=owner@example.com
BOOTSTRAP_TOKEN=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-another-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=55432
DATABASE_URL=postgres://agentpanel:replace-with-a-random-database-password@127.0.0.1:55432/agentpanel
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
WEBAUTHN_RP_ID=localhost
PORT=8787
EVENT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
# Set VAPID keys to enable real Web Push; setup.ts generates them locally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# APNs requires an Apple team, key, topic and signed client provisioning.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=dev.agentpanel.client
APNS_IOS_TOPIC=dev.agentpanel.client
APNS_MACOS_TOPIC=dev.agentpanel.client.mac
APNS_PRODUCTION=false
